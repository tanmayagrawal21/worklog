# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp

# Logs / scratch
*.log
tmp/
scratch/

# Secrets never belong in this repo.
# The app keeps tokens in browser localStorage, never in a file — these entries
# exist to catch a stray local config before it is committed by accident.
.env
.env.*
*.token
secrets.json

# There is a package.json so `npx work-log` can serve the app, but it declares no
# dependencies -- an install tree here means something crept in. Keep it, and any
# local `npm pack` tarball, out of git.
node_modules/
*.tgz
npm-debug.log*
package-lock.json
